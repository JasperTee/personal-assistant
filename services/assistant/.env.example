# copy this file to .env and fill in real values; never commit .env

# Telegram — one token per bot (from BotFather); phase 1 only needs the Secretary.
TELEGRAM_TOKEN_SECRETARY=
TELEGRAM_TOKEN_RENTAL=
TELEGRAM_TOKEN_FINANCE=
TELEGRAM_TOKEN_EMAIL=
TELEGRAM_TOKEN_DOCUMENTS=
TELEGRAM_TOKEN_LEARNING=
TELEGRAM_TOKEN_MARKET=
TELEGRAM_TOKEN_RESEARCH=
# webhook (ADR-29): public HTTPS base URL (laptop: the cloudflared tunnel URL) and a long random secret
# use a separate dev bot token on the laptop; never point the real bot at a laptop tunnel
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=

# allowlist — your Telegram user id
OWNER_TELEGRAM_ID=

# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# database (phase 1: SQLite)
DATABASE_URL=sqlite:///data/assistant.db

# Google (phase 4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
