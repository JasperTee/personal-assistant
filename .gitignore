# Secrets — never commit
.env
*.key
credentials*.json
token*.json

# Local data (one data/ folder per app or service)
apps/*/data/*
!apps/*/data/.gitkeep
services/*/data/*
!services/*/data/.gitkeep
*.sqlite
*.db

# .NET build output and local tools
bin/
obj/
TestResults/
*.user
.vs/

# Python (services/market)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Log
logs/
*.log

# OS / IDE
.DS_Store
.idea/
.vscode/
