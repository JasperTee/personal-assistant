# copy this file to .env and fill in real values; never commit .env

# Telegram — one token per bot (from BotFather); the MVP needs Secretary, Life and Housing.
TELEGRAM_TOKEN_SECRETARY=
TELEGRAM_TOKEN_LIFE=
TELEGRAM_TOKEN_HOUSING=
TELEGRAM_TOKEN_FINANCE=
TELEGRAM_TOKEN_LEARNING=
TELEGRAM_TOKEN_MARKET=
# the bot polls Telegram (ADR-31); on the laptop use a separate dev bot token, because only one
# process may poll a token and the server runs the real one

# allowlist — your Telegram user id
OWNER_TELEGRAM_ID=

# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# database (phase 1: SQLite)
DATABASE_URL=sqlite:///data/assistant.db

# Google (phase 4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
